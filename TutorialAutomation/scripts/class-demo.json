{
    "version": 2,
    "destination": "C:/Users/hinatardp/Desktop/Class Demo",
    "progress_file": "../../logs/class-demo.state",
    "countdown_seconds": 10,
    "seed": 0,

    "files": {
        "folder": "class-demo",
        "include": ["*.py", "*.cjs"],
        "list": ["grades.py", "shopping-list.cjs"],
        "order": "listed"
    },

    "typing": {
        "character_ms": [60, 120],
        "newline_ms": [400, 900],
